GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VOICE_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE_NAME=Kore
SOUL_NAME=Soul
SOUL_TTS_ENABLED=true
SOUL_STREAMING=true
SOUL_MEMORY_ENABLED=true
SOUL_DEBUG=false
SOUL_HISTORY_TURNS=12
SOUL_MEMORY_LIMIT=6
# SOUL_SYSTEM_PROMPT_FILE=personality.txt

# Parts 2 and 3
SOUL_TOOLS_ENABLED=true
SOUL_VISION_ENABLED=true
# Empty uses GEMINI_TEXT_MODEL for multimodal grounding
GEMINI_VISION_MODEL=
SOUL_MAX_TOOL_ITERATIONS=10
SOUL_MAX_TOOL_CALLS=24
SOUL_TOOL_TIMEOUT=25
SOUL_TURN_TIMEOUT=240
# 0 = active window's display; 1+ = explicit monitor index
SOUL_MONITOR=0
SOUL_TARGET_CONFIDENCE=0.85
SOUL_TARGET_TTL=90
SOUL_MAX_CLICKS=6
SOUL_MAX_SCROLLS=5
SOUL_ACTION_INTERVAL=0.5
SOUL_REQUEST_TIMEOUT=20
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
SOUL_BACKGROUND_VOICE=true
SOUL_FAST_RESPONSES=true

SOUL_RESPONSE_MODE=full

# SOUL V2: desktop is the default; python main.py --cli retains terminal mode.
SOUL_MICROPHONE_ENABLED=true
SOUL_MICROPHONE_MAX_SECONDS=30
SOUL_VISION_MAX_DIMENSION=1600
SOUL_VISUAL_CONTEXT_TTL=30
SOUL_UIA_ENABLED=true
SOUL_MAX_KEYBOARD_ACTIONS=8
SOUL_MAX_TYPED_CHARACTERS=4000
SOUL_MAX_RETRIES=2
SOUL_MAX_PARALLEL_READS=4
SOUL_REDUCED_MOTION=false
SOUL_VISUAL_QUALITY=auto
